{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "decision-proposal.schema.json",
  "title": "Decision Proposal",
  "description": "A proposal for a consequential decision, submitted for human review.",
  "type": "object",
  "required": ["proposal_id", "proposed_by", "proposed_date", "status", "title", "context", "decision", "alternatives", "consequences"],
  "properties": {
    "proposal_id": {
      "type": "string",
      "description": "Unique identifier (e.g., ADR-XXXX or a timestamp-based ID for informal proposals)."
    },
    "proposed_by": {
      "type": "string",
      "description": "Name of the agent or person proposing this decision."
    },
    "proposed_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "rejected", "superseded"],
      "description": "Human-assigned status. Agents must only submit proposals with status 'proposed'."
    },
    "title": {
      "type": "string",
      "description": "Short title for the decision."
    },
    "context": {
      "type": "string",
      "description": "Why this decision is needed."
    },
    "decision": {
      "type": "string",
      "description": "The proposed course of action."
    },
    "alternatives": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alternatives that were considered."
    },
    "consequences": {
      "type": "string",
      "description": "Expected consequences if this decision is accepted."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "title", "access_date", "claim_type"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "access_date": { "type": "string", "format": "date" },
          "claim_type": {
            "type": "string",
            "enum": ["evidence", "inference", "vendor-claim", "opinion"]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
