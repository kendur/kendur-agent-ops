{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "product-score.schema.json",
  "title": "Product Score",
  "description": "An agent's scored assessment of a product at a point in time. Prior scores are never overwritten; a new record is created for each reassessment.",
  "type": "object",
  "required": ["score_id", "agent", "scored_date", "product_name", "relevance", "rationale", "sources"],
  "properties": {
    "score_id": {
      "type": "string",
      "description": "Unique identifier for this score record."
    },
    "agent": {
      "type": "string",
      "enum": [
        "capture-ecosystem-analyst",
        "market-community-analyst"
      ]
    },
    "scored_date": {
      "type": "string",
      "format": "date"
    },
    "product_name": {
      "type": "string"
    },
    "product_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "relevance": {
      "type": "string",
      "enum": ["high", "medium", "low", "not-relevant"],
      "description": "How relevant this product is to the Executive Support System."
    },
    "rationale": {
      "type": "string",
      "description": "Plain-language explanation of the relevance score."
    },
    "prior_score_id": {
      "type": ["string", "null"],
      "description": "Score ID of the previous assessment, if this is a reassessment."
    },
    "change_from_prior": {
      "type": ["string", "null"],
      "description": "If reassessment, briefly describe what changed."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "title", "access_date", "claim_type"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "access_date": { "type": "string", "format": "date" },
          "claim_type": {
            "type": "string",
            "enum": ["evidence", "inference", "vendor-claim", "opinion"]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
